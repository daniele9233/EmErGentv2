{
  "name": "@emergent/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, framework-agnostic shared utilities",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@emergent/config": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
